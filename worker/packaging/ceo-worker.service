[Unit]
Description=CEO Worker Plane
Documentation=https://github.com/SentimentalK/chief-everything-officer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__CEO_WORKER_USER__
EnvironmentFile=-/etc/ceo/worker/worker.env
ExecStart=/usr/local/bin/ceo-worker bridge run --config /etc/ceo/worker/bridge.json --workspace-ref ${CEO_WORKSPACE_REF}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
